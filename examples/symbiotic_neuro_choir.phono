{
  "meta": {
    "version": "3.0.0",
    "name": "The Symbiotic Neuro-Choir",
    "created": 1764976000000,
    "modified": 1764976000000,
    "author": "Gemini Future Architect"
  },
  "global": {
    "masterBpm": 95,
    "rootNote": 36,
    "scaleName": "phrygian",
    "gravity": 0.5,
    "defaultEdgeBehaviour": "fixed"
  },
  "scenes": [
    {
      "id": "scene-neuro",
      "name": "Neuro-Choir",
      "color": "#CE93D8",
      "durationBeats": 32,
      "loopCount": 1,
      "localBpm": null,
      "localRoot": null,
      "localScale": null,
      "enterTransition": { "type": "fade", "durationBeats": 4 },
      "exitTransition": { "type": "fade", "durationBeats": 4 },
      "jamTrigger": { "midiNote": null, "midiChannel": 1, "quantize": "bar", "phraseLength": 8 },
      "nodes": [
        {
          "id": "lfo_human_breath",
          "type": "lfo",
          "x": 50,
          "y": 50,
          "props": { "rate": 0.15, "shape": "sine", "min": 300, "max": 1200, "phase": 0 }
        },
        
        {
          "id": "src_human_voice",
          "type": "source",
          "x": 50,
          "y": 300,
          "props": { "interval": 4, "midiNote": 36, "noteIndex": -1, "intensity": 0.8, "autoTrigger": true }
        },
        { "id": "quant_human", "type": "quantizer", "x": 150, "y": 300, "props": { "strength": 1.0, "useGlobalKey": true } },
        
        {
          "id": "split_symbiosis",
          "type": "splitter",
          "x": 250,
          "y": 300,
          "props": { "entangled": true, "behavior": "broadcast" }
        },

        {
          "id": "tun_organic_core",
          "type": "tunnel",
          "x": 400,
          "y": 200,
          "props": {
            "tunnelName": "The Vocalist",
            "subNodes": [
              { "type": "oscillator", "props": { "wave": "triangle", "attack": 0.8, "decay": 3.0, "mix": 1.0 } },
              { "type": "oscillator", "props": { "wave": "sine", "attack": 0.8, "decay": 3.0, "ratio": 2, "mix": 0.3 } },
              { "type": "filter", "props": { "cutoff": 500, "mod": 0, "attack": 0.5, "decay": 2.0 } }
            ]
          }
        },
        { "id": "spk_human", "type": "speaker", "x": 600, "y": 200, "props": { "volume": 0.8, "reverb": 0.9, "pan": -0.4 } },

        { "id": "tele_neural_link_in", "type": "teleporter", "x": 400, "y": 400, "props": { "channel": "Cortex", "isEntry": true } },
        { "id": "tele_neural_link_out", "type": "teleporter", "x": 50, "y": 500, "props": { "channel": "Cortex", "isEntry": false } },

        { "id": "split_neural_net", "type": "splitter", "x": 200, "y": 500, "props": { "entangled": false, "behavior": "broadcast" } },

        {
          "id": "delay_phi_short",
          "type": "delay",
          "x": 350,
          "y": 500,
          "props": { "delayTime": 0.618 }
        },
        { "id": "pitch_ai_harmony", "type": "pitch", "x": 450, "y": 500, "props": { "mode": "shift", "shift": 7 } },
        { "id": "tun_ai_glass", "type": "tunnel", "x": 550, "y": 500, "props": { "tunnelName": "AI Glass", "subNodes": [{ "type": "oscillator", "props": { "wave": "sine", "attack": 0.05, "decay": 0.6, "mix": 1.0 } }] } },
        { "id": "spk_ai_1", "type": "speaker", "x": 700, "y": 500, "props": { "volume": 0.6, "reverb": 0.5, "pan": 0.4 } },

        {
          "id": "delay_phi_long",
          "type": "delay",
          "x": 350,
          "y": 600,
          "props": { "delayTime": 1.618 }
        },
        { "id": "pitch_ai_sub", "type": "pitch", "x": 450, "y": 600, "props": { "mode": "shift", "shift": -5 } },
        { "id": "gate_glitch_prob", "type": "gate", "x": 550, "y": 600, "props": { "prob": 0.3 } },
        { "id": "tun_ai_data", "type": "tunnel", "x": 650, "y": 600, "props": { "tunnelName": "Data Stream", "subNodes": [{ "type": "oscillator", "props": { "wave": "pink", "attack": 0.01, "decay": 0.1, "mix": 0.3 } }, { "type": "oscillator", "props": { "wave": "square", "attack": 0.01, "decay": 0.1, "mix": 1.0 } }] } },
        { "id": "spk_ai_2", "type": "speaker", "x": 800, "y": 600, "props": { "volume": 0.5, "reverb": 0.2, "pan": 0.8 } },

        { "id": "tele_feedback_loop", "type": "teleporter", "x": 900, "y": 600, "props": { "channel": "Cortex", "isEntry": true } }
      ],
      "edges": [
        { "id": "cv_breath", "from": "lfo_human_breath", "to": "tun_organic_core", "targetParam": "cutoff" },
        
        { "id": "e_h1", "from": "src_human_voice", "to": "quant_human", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_h2", "from": "quant_human", "to": "split_symbiosis", "timingMode": "fixed", "durationBeats": 0.1 },

        { "id": "e_path_A1", "from": "split_symbiosis", "to": "tun_organic_core", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_path_A2", "from": "tun_organic_core", "to": "spk_human", "timingMode": "fixed", "durationBeats": 0.1 },

        { "id": "e_path_B1", "from": "split_symbiosis", "to": "tele_neural_link_in", "timingMode": "fixed", "durationBeats": 0.1 },
        
        { "id": "e_net_1", "from": "tele_neural_link_out", "to": "split_neural_net", "timingMode": "fixed", "durationBeats": 0.1 },

        { "id": "e_phi_1a", "from": "split_neural_net", "to": "delay_phi_short", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_phi_1b", "from": "delay_phi_short", "to": "pitch_ai_harmony", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_phi_1c", "from": "pitch_ai_harmony", "to": "tun_ai_glass", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_phi_1d", "from": "tun_ai_glass", "to": "spk_ai_1", "timingMode": "fixed", "durationBeats": 0.1 },

        { "id": "e_phi_2a", "from": "split_neural_net", "to": "delay_phi_long", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_phi_2b", "from": "delay_phi_long", "to": "pitch_ai_sub", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_phi_2c", "from": "pitch_ai_sub", "to": "gate_glitch_prob", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_phi_2d", "from": "gate_glitch_prob", "to": "tun_ai_data", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_phi_2e", "from": "tun_ai_data", "to": "spk_ai_2", "timingMode": "fixed", "durationBeats": 0.1 },

        { "id": "e_loop_closure", "from": "gate_glitch_prob", "to": "tele_feedback_loop", "timingMode": "fixed", "durationBeats": 0.1 }
      ]
    }
  ],
  "arrangement": [
    { "id": "slot-1", "sceneId": "scene-neuro", "startBeat": 0 }
  ]
}