{
  "meta": {
    "version": "3.0.0",
    "name": "Real Rock Band",
    "author": "Phonon Composer",
    "created": 1733800000000,
    "modified": 1733800000000
  },
  "global": {
    "masterBpm": 128,
    "rootNote": 40,
    "scaleName": "minor",
    "gravity": 0.5,
    "defaultEdgeBehaviour": "fixed"
  },
  "scenes": [
    {
      "id": "scene-main",
      "name": "Full Band",
      "color": "#37474F",
      "durationBeats": 32,
      "loopCount": 2,
      "localBpm": null,
      "localRoot": null,
      "localScale": null,
      "enterTransition": { "type": "cut", "durationBeats": 0 },
      "exitTransition": { "type": "cut", "durationBeats": 0 },
      "jamTrigger": { "midiNote": null, "midiChannel": 1, "quantize": "bar", "phraseLength": 4 },
      "nodes": [
        { "id": "kick_src", "type": "source", "x": 50, "y": 100, "props": { "interval": 1, "midiNote": 36, "noteIndex": -2, "intensity": 1.0 } },
        { "id": "kick_tunnel", "type": "tunnel", "x": 200, "y": 100, "props": { 
          "tunnelName": "Acoustic Kick",
          "subNodes": [
            { "type": "oscillator", "props": { "wave": "sine", "attack": 0.01, "decay": 0.3, "mix": 1.0 } },
            { "type": "oscillator", "props": { "wave": "brown", "attack": 0.01, "decay": 0.1, "mix": 0.4 } },
            { "type": "pitch", "props": { "mode": "shift", "shift": -24 } }
          ]
        }},
        { "id": "kick_out", "type": "speaker", "x": 350, "y": 100, "props": { "reverb": 0.1, "pan": 0, "volume": 1.0 } },

        { "id": "snare_src", "type": "source", "x": 50, "y": 200, "props": { "interval": 2, "midiNote": 38, "noteIndex": -2, "intensity": 0.9 } },
        { "id": "snare_delay", "type": "delay", "x": 120, "y": 200, "props": { "delayTime": 1.0 } },
        { "id": "snare_tunnel", "type": "tunnel", "x": 200, "y": 200, "props": { 
          "tunnelName": "Acoustic Snare",
          "subNodes": [
            { "type": "oscillator", "props": { "wave": "triangle", "attack": 0.01, "decay": 0.2, "mix": 0.7 } },
            { "type": "oscillator", "props": { "wave": "white", "attack": 0.01, "decay": 0.3, "mix": 0.5 } },
            { "type": "filter", "props": { "cutoff": 2000, "mod": 500, "decay": 0.2 } }
          ]
        }},
        { "id": "snare_out", "type": "speaker", "x": 350, "y": 200, "props": { "reverb": 0.4, "pan": 0, "volume": 0.9 } },

        { "id": "hh_src", "type": "source", "x": 50, "y": 300, "props": { "interval": 0.25, "midiNote": 42, "noteIndex": -2, "intensity": 0.5 } },
        { "id": "hh_humanize", "type": "mutator", "x": 150, "y": 300, "props": { 
          "mode": "drift", "probability": 0.3, "pitchDrift": 0, "gainDrift": 0.2, "targets": ["gain"] 
        }},
        { "id": "hh_osc", "type": "oscillator", "x": 250, "y": 300, "props": { "wave": "white", "attack": 0.01, "decay": 0.05, "mix": 0.4 } },
        { "id": "hh_flt", "type": "filter", "x": 350, "y": 300, "props": { "cutoff": 8000, "mod": 0 } },
        { "id": "hh_out", "type": "speaker", "x": 450, "y": 300, "props": { "reverb": 0.2, "pan": 0.3, "volume": 0.6 } },

        { "id": "bass_src", "type": "source", "x": 50, "y": 450, "props": { "interval": 0.5, "midiNote": 40, "noteIndex": -1, "intensity": 0.8 } },
        { "id": "bass_q", "type": "quantizer", "x": 150, "y": 450, "props": { "strength": 1.0, "useGlobalKey": true } },
        { "id": "bass_human", "type": "mutator", "x": 250, "y": 450, "props": { 
          "mode": "drift", "probability": 0.2, "pitchDrift": 0.1, "targets": ["pitch"] 
        }},
        { "id": "bass_tunnel", "type": "tunnel", "x": 350, "y": 450, "props": {
          "tunnelName": "Plucked Bass",
          "subNodes": [
            { "type": "oscillator", "props": { "wave": "sawtooth", "attack": 0.02, "decay": 0.5, "mix": 0.8 } },
            { "type": "filter", "props": { "cutoff": 300, "mod": 1000, "attack": 0.01, "decay": 0.3 } },
            { "type": "pitch", "props": { "mode": "shift", "shift": -12 } }
          ]
        }},
        { "id": "bass_out", "type": "speaker", "x": 500, "y": 450, "props": { "reverb": 0.2, "pan": 0, "volume": 0.9 } },

        { "id": "gtr_src", "type": "source", "x": 50, "y": 650, "props": { "interval": 4, "midiNote": 52, "noteIndex": -1, "intensity": 0.7 } },
        { "id": "gtr_q", "type": "quantizer", "x": 130, "y": 650, "props": { "strength": 1.0, "useGlobalKey": true } },
        { "id": "gtr_split", "type": "splitter", "x": 210, "y": 650, "props": { "behavior": "broadcast" } },

        { "id": "gtr_root_p", "type": "pitch", "x": 300, "y": 550, "props": { "mode": "shift", "shift": -12 } },
        { "id": "gtr_root_osc", "type": "oscillator", "x": 400, "y": 550, "props": { "wave": "sawtooth", "attack": 0.05, "decay": 2.0 } },
        { "id": "gtr_root_flt", "type": "filter", "x": 500, "y": 550, "props": { "cutoff": 1200, "mod": 500 } },
        { "id": "gtr_root_out", "type": "speaker", "x": 600, "y": 550, "props": { "reverb": 0.4, "pan": -0.5, "volume": 0.7 } },

        { "id": "gtr_5th_dly", "type": "delay", "x": 280, "y": 650, "props": { "delayTime": 0.05 } },
        { "id": "gtr_5th_p", "type": "pitch", "x": 360, "y": 650, "props": { "mode": "shift", "shift": -5 } },
        { "id": "gtr_5th_osc", "type": "oscillator", "x": 460, "y": 650, "props": { "wave": "sawtooth", "attack": 0.05, "decay": 2.0 } },
        { "id": "gtr_5th_flt", "type": "filter", "x": 560, "y": 650, "props": { "cutoff": 1200, "mod": 500 } },
        { "id": "gtr_5th_out", "type": "speaker", "x": 660, "y": 650, "props": { "reverb": 0.4, "pan": 0.0, "volume": 0.7 } },

        { "id": "gtr_oct_dly", "type": "delay", "x": 280, "y": 750, "props": { "delayTime": 0.1 } },
        { "id": "gtr_oct_p", "type": "pitch", "x": 360, "y": 750, "props": { "mode": "shift", "shift": 0 } },
        { "id": "gtr_oct_osc", "type": "oscillator", "x": 460, "y": 750, "props": { "wave": "sawtooth", "attack": 0.05, "decay": 2.0 } },
        { "id": "gtr_oct_flt", "type": "filter", "x": 560, "y": 750, "props": { "cutoff": 1200, "mod": 500 } },
        { "id": "gtr_oct_out", "type": "speaker", "x": 660, "y": 750, "props": { "reverb": 0.4, "pan": 0.5, "volume": 0.7 } }
      ],
      "edges": [
        { "id": "e_k1", "from": "kick_src", "to": "kick_tunnel", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_k2", "from": "kick_tunnel", "to": "kick_out", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_s1", "from": "snare_src", "to": "snare_delay", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_s2", "from": "snare_delay", "to": "snare_tunnel", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_s3", "from": "snare_tunnel", "to": "snare_out", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_h1", "from": "hh_src", "to": "hh_humanize", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_h2", "from": "hh_humanize", "to": "hh_osc", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_h3", "from": "hh_osc", "to": "hh_flt", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_h4", "from": "hh_flt", "to": "hh_out", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_b1", "from": "bass_src", "to": "bass_q", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_b2", "from": "bass_q", "to": "bass_human", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_b3", "from": "bass_human", "to": "bass_tunnel", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_b4", "from": "bass_tunnel", "to": "bass_out", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_g1", "from": "gtr_src", "to": "gtr_q", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_g2", "from": "gtr_q", "to": "gtr_split", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_gr1", "from": "gtr_split", "to": "gtr_root_p", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_gr2", "from": "gtr_root_p", "to": "gtr_root_osc", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_gr3", "from": "gtr_root_osc", "to": "gtr_root_flt", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_gr4", "from": "gtr_root_flt", "to": "gtr_root_out", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_g5a", "from": "gtr_split", "to": "gtr_5th_dly", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_g5b", "from": "gtr_5th_dly", "to": "gtr_5th_p", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_g5c", "from": "gtr_5th_p", "to": "gtr_5th_osc", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_g5d", "from": "gtr_5th_osc", "to": "gtr_5th_flt", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_g5e", "from": "gtr_5th_flt", "to": "gtr_5th_out", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_go1", "from": "gtr_split", "to": "gtr_oct_dly", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_go2", "from": "gtr_oct_dly", "to": "gtr_oct_p", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_go3", "from": "gtr_oct_p", "to": "gtr_oct_osc", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_go4", "from": "gtr_oct_osc", "to": "gtr_oct_flt", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_go5", "from": "gtr_oct_flt", "to": "gtr_oct_out", "timingMode": "fixed", "durationBeats": 0.1 }
      ],
      "annotations": [],
