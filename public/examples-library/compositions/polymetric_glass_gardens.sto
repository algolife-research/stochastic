{
  "meta": {
    "version": "3.0.0",
    "name": "Polymetric Glass Gardens",
    "created": 1764973000000,
    "modified": 1764973000000,
    "author": "Gemini Future Architect"
  },
  "global": {
    "masterBpm": 100,
    "rootNote": 53,
    "scaleName": "lydian",
    "gravity": 0.5,
    "defaultEdgeBehaviour": "fixed"
  },
  "scenes": [
    {
      "id": "scene-gardens",
      "name": "Glass Gardens",
      "color": "#80DEEA",
      "durationBeats": 48,
      "loopCount": 1,
      "localBpm": null,
      "localRoot": null,
      "localScale": null,
      "enterTransition": { "type": "fade", "durationBeats": 4 },
      "exitTransition": { "type": "fade", "durationBeats": 4 },
      "jamTrigger": { "midiNote": null, "midiChannel": 1, "quantize": "bar", "phraseLength": 12 },
      "nodes": [
        {
          "id": "src_seed",
          "type": "source",
          "x": 50,
          "y": 250,
          "props": { "interval": 12, "midiNote": 53, "noteIndex": -2, "intensity": 0.9, "autoTrigger": true }
        },
        
        {
          "id": "tele_entry_loop",
          "type": "teleporter",
          "x": 200,
          "y": 250,
          "props": { "channel": "Spiral", "isEntry": true }
        },
        {
          "id": "tele_exit_loop",
          "type": "teleporter",
          "x": 200,
          "y": 400,
          "props": { "channel": "Spiral", "isEntry": false }
        },

        {
          "id": "split_main",
          "type": "splitter",
          "x": 350,
          "y": 400,
          "props": { "entangled": true, "behavior": "broadcast" }
        },

        {
          "id": "tun_glass",
          "type": "tunnel",
          "x": 500,
          "y": 350,
          "props": {
            "tunnelName": "Glass Chime",
            "subNodes": [
              { "type": "oscillator", "props": { "wave": "sine", "attack": 0.05, "decay": 1.5, "mix": 1.0 } },
              { "type": "filter", "props": { "cutoff": 3000, "mod": 500, "attack": 0.01, "decay": 0.2 } },
              { "type": "oscillator", "props": { "wave": "sine", "attack": 0.1, "decay": 0.5, "ratio": 4, "mix": 0.3 } }
            ]
          }
        },
        {
          "id": "spk_main",
          "type": "speaker",
          "x": 650,
          "y": 350,
          "props": { "volume": 0.7, "reverb": 0.8, "pan": 0.3 }
        },

        {
          "id": "delay_fdbk",
          "type": "delay",
          "x": 500,
          "y": 500,
          "props": { "delayTime": 1.5 }
        },
        {
          "id": "pitch_fdbk",
          "type": "pitch",
          "x": 600,
          "y": 500,
          "props": { "mode": "shift", "shift": 7 }
        },
        {
          "id": "gain_decay",
          "type": "gain",
          "x": 700,
          "y": 500,
          "props": { "value": 0.8 }
        },
        {
          "id": "gate_chaos",
          "type": "gate",
          "x": 800,
          "y": 500,
          "props": { "prob": 0.9 }
        },

        {
          "id": "src_bass",
          "type": "source",
          "x": 50,
          "y": 600,
          "props": { "interval": 4, "midiNote": 41, "noteIndex": -2, "intensity": 0.8, "autoTrigger": true }
        },
        {
          "id": "tun_bass",
          "type": "tunnel",
          "x": 250,
          "y": 600,
          "props": {
            "tunnelName": "Deep Swell",
            "subNodes": [
              { "type": "oscillator", "props": { "wave": "triangle", "attack": 0.8, "decay": 1.5, "mix": 1.0 } },
              { "type": "filter", "props": { "cutoff": 600, "mod": 0 } }
            ]
          }
        },
        {
          "id": "spk_bass",
          "type": "speaker",
          "x": 450,
          "y": 600,
          "props": { "volume": 0.9, "reverb": 0.9, "pan": -0.2 }
        },
        {
          "id": "lfo_swell",
          "type": "lfo",
          "x": 250,
          "y": 700,
          "props": { "rate": 0.1, "shape": "sine", "min": 200, "max": 800 }
        }
      ],
      "edges": [
        { "id": "e_seed_in", "from": "src_seed", "to": "tele_entry_loop", "timingMode": "fixed", "durationBeats": 0.5 },
        
        { "id": "e_loop_out_split", "from": "tele_exit_loop", "to": "split_main", "timingMode": "fixed", "durationBeats": 0.1 },
        
        { "id": "e_audio_1", "from": "split_main", "to": "tun_glass", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_audio_2", "from": "tun_glass", "to": "spk_main", "timingMode": "fixed", "durationBeats": 0.1 },
        
        { "id": "e_fb_1", "from": "split_main", "to": "delay_fdbk", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_fb_2", "from": "delay_fdbk", "to": "pitch_fdbk", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_fb_3", "from": "pitch_fdbk", "to": "gain_decay", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_fb_4", "from": "gain_decay", "to": "gate_chaos", "timingMode": "fixed", "durationBeats": 0.1 },
        { "id": "e_fb_5", "from": "gate_chaos", "to": "tele_entry_loop", "timingMode": "fixed", "durationBeats": 0.1 },

        { "id": "e_bass_1", "from": "src_bass", "to": "tun_bass", "timingMode": "fixed", "durationBeats": 0.5 },
        { "id": "e_bass_2", "from": "tun_bass", "to": "spk_bass", "timingMode": "fixed", "durationBeats": 0.5 },
        { "id": "e_lfo_bass", "from": "lfo_swell", "to": "tun_bass", "targetParam": "cutoff" }
      ]
    }
  ],
  "arrangement": [
    { "id": "slot-1", "sceneId": "scene-gardens", "startBeat": 0 }
  ]
}