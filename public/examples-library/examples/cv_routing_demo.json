      "x": 560,
      "y": 300,
      "props": {
        "reverb": 0.7,
        "pan": 0
      }
    },
    {
      "id": "lfo_cutoff",
      "type": "lfo",
      "x": 440,
      "y": 150,
      "props": {
        "rate": 0.2,
        "shape": "sine",
        "min": 200,
        "max": 3000
      }
    },
    {
      "id": "lfo_pan",
      "type": "lfo",
      "x": 560,
      "y": 150,
      "props": {
        "rate": 0.15,
        "shape": "triangle",
        "min": -1,
        "max": 1
      }
    },
    {
      "id": "lfo_gain",
      "type": "lfo",
      "x": 320,
      "y": 450,
      "props": {
        "rate": 0.5,
        "shape": "sine",
        "min": 0.3,
        "max": 1
      }
    },
    {
      "id": "src2",
      "type": "source",
      "x": 80,
      "y": 500,
      "props": {
        "interval": 6,
        "midiNote": 36,
        "noteIndex": -2,
        "intensity": 0.8
      }
    },
    {
      "id": "pol2",
      "type": "oscillator",
      "x": 200,
      "y": 500,
      "props": {
        "wave": "sine",
        "attack": 0.5,
        "decay": 3
      }
    },
    {
      "id": "out2",
      "type": "speaker",
      "x": 320,
      "y": 500,
      "props": {
        "reverb": 0.5,
        "pan": 0
      }
    }
