  "edges": [
    {
      "id": "e1",
      "from": "src",
      "to": "pol"
    },
    {
      "id": "e2",
      "from": "pol",
      "to": "gain"
    },
    {
      "id": "e3",
      "from": "gain",
      "to": "flt"
    },
    {
      "id": "e4",
      "from": "flt",
      "to": "out"
    },
    {
      "id": "e_lfo1",
      "from": "lfo_cutoff",
      "to": "flt",
      "targetParam": "cutoff"
    },
    {
      "id": "e_lfo2",
      "from": "lfo_pan",
      "to": "out",
      "targetParam": "pan"
    },
    {
      "id": "e_lfo3",
      "from": "lfo_gain",
      "to": "gain",
      "targetParam": "value"
    },
    {
      "id": "e5",
      "from": "src2",
      "to": "pol2"
    },
    {
      "id": "e6",
      "from": "pol2",
      "to": "out2"
    }
