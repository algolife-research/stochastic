      "x": 200,
      "y": 300,
      "props": {
        "tunnelName": "Warm Pad",
        "subNodes": [
          {
            "type": "oscillator",
            "props": {
              "wave": "sine",
              "attack": 0.8,
              "decay": 3
            }
          },
          {
            "type": "oscillator",
            "props": {
              "wave": "triangle",
              "attack": 1.2,
              "decay": 2.5
            }
          },
          {
            "type": "oscillator",
            "props": {
              "wave": "sawtooth",
              "attack": 0.5,
              "decay": 2
            }
          }
        ]
      }
    },
    {
      "id": "out",
      "type": "speaker",
      "x": 340,
      "y": 300,
      "props": {
        "reverb": 0.8,
        "pan": 0
      }
    },
    {
      "id": "split",
      "type": "splitter",
      "x": 200,
      "y": 150,
      "props": {}
    },
    {
      "id": "p_hi",
      "type": "pitch",
      "x": 280,
      "y": 150,
      "props": {
        "shift": 12
      }
    },
    {
