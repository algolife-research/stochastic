    },
    {
      "id": "gain",
      "type": "gain",
      "x": 420,
      "y": 300,
      "props": {
        "value": 0.8
      }
    },
    {
      "id": "out",
      "type": "speaker",
      "x": 540,
      "y": 300,
      "props": {
        "reverb": 0.2,
        "pan": 0
      }
    },
    {
      "id": "lfo_fast",
      "type": "lfo",
      "x": 300,
      "y": 150,
      "props": {
        "rate": 4,
        "shape": "sine",
        "min": 200,
        "max": 2500
      }
    },
    {
      "id": "lfo_slow",
      "type": "lfo",
      "x": 420,
      "y": 150,
      "props": {
        "rate": 0.5,
        "shape": "triangle",
        "min": 0.4,
        "max": 1
      }
    },
    {
      "id": "src_sub",
      "type": "source",
      "x": 60,
      "y": 450,
      "props": {
        "interval": 2,
        "midiNote": 36,
        "noteIndex": -2,
        "intensity": 0.9
      }
    },
    {
      "id": "p_sub",
      "type": "pitch",
      "x": 160,
      "y": 450,
      "props": {
        "shift": -12
      }
    },
    {
      "id": "pol_sub",
      "type": "oscillator",
      "x": 260,
      "y": 450,
      "props": {
        "wave": "sine",
        "attack": 0.01,
        "decay": 0.6
      }
    },
    {
      "id": "out_sub",
      "type": "speaker",
      "x": 380,
      "y": 450,
      "props": {
        "reverb": 0.1,
        "pan": 0
      }
