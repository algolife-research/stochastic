{
  "name": "Advanced: Wobble Bass",
  "category": "Synthesis",
  "description": "Multiple LFOs at different rates create complex wobble bass movements.",
  "bpm": 140,
  "nodes": [
    {
      "id": "src",
      "type": "source",
      "x": 60,
      "y": 300,
      "props": {
        "interval": 2,
        "midiNote": 36,
        "noteIndex": -2,
        "intensity": 0.8
      }
    },
    {
      "id": "pol",
      "type": "oscillator",
      "x": 180,
