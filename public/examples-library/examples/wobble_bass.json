  "edges": [
    {
      "id": "e1",
      "from": "src",
      "to": "pol"
    },
    {
      "id": "e2",
      "from": "pol",
      "to": "flt"
    },
    {
      "id": "e3",
      "from": "flt",
      "to": "gain"
    },
    {
      "id": "e4",
