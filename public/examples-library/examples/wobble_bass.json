      "targetParam": "cutoff"
    },
    {
      "id": "e_lfo2",
      "from": "lfo_slow",
      "to": "gain",
      "targetParam": "value"
    },
    {
      "id": "e5",
      "from": "src_sub",
      "to": "p_sub"
    },
    {
      "id": "e6",
      "from": "p_sub",
      "to": "pol_sub"
    },
    {
      "id": "e7",
