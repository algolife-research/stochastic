      "type": "quantizer",
      "x": 420,
      "y": 250,
      "props": {
        "strength": 1
      }
    },
    {
      "id": "pol",
      "type": "oscillator",
      "x": 540,
      "y": 250,
      "props": {
        "wave": "triangle",
        "attack": 0.02,
        "decay": 0.3
      }
    },
    {
      "id": "out",
      "type": "speaker",
      "x": 660,
      "y": 250,
      "props": {
        "reverb": 0.4,
        "pan": 0
      }
    },
    {
      "id": "bass_seed",
