      "x": 160,
      "y": 420,
      "props": {
        "value": 1.5
      }
    },
    {
      "id": "pol_swell",
      "type": "oscillator",
      "x": 260,
      "y": 420,
      "props": {
        "wave": "sine",
        "attack": 0.2,
        "decay": 0.6
      }
    },
    {
