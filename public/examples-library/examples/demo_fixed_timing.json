{
  "name": "Demo: Fixed Edge Timing",
  "category": "Demos",
  "description": "Shows edge timing modes: physical (distance-based) vs fixed (beat-based) travel time.",
  "bpm": 120,
  "nodes": [
    {
      "id": "src",
      "type": "source",
      "x": 100,
      "y": 200,
      "props": {
        "interval": 2,
        "midiNote": 60,
        "noteIndex": -2,
        "intensity": 0.6
      }
    },
    {
      "id": "pol1",
      "type": "oscillator",
      "x": 300,
      "y": 200,
      "props": {
        "wave": "sine",
        "attack": 0.02,
        "decay": 0.4
      }
    },
    {
      "id": "spk1",
      "type": "speaker",
      "x": 500,
      "y": 200,
      "props": {
        "reverb": 0.3,
        "pan": -0.3
      }
    },
    {
      "id": "pol2",
      "type": "oscillator",
      "x": 300,
      "y": 350,
      "props": {
        "wave": "triangle",
        "attack": 0.02,
        "decay": 0.4
      }
    },
    {
      "id": "spk2",
      "type": "speaker",
      "x": 500,
      "y": 350,
      "props": {
        "reverb": 0.3,
        "pan": 0.3
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "src",
      "to": "pol1"
    },
    {
      "id": "e2",
      "from": "pol1",
      "to": "spk1"
    },
    {
      "id": "e3",
      "from": "src",
      "to": "pol2",
      "timingMode": "fixed",
      "durationBeats": 1
    },
    {
      "id": "e4",
      "from": "pol2",
      "to": "spk2"
    }
  ]
}