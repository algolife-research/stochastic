{
  "name": "Demo: Simple Melody",
  "category": "Demos",
  "description": "A 4-note melody created by chaining speakers with pitch shifts.",
  "bpm": 100,
  "nodes": [
    {
      "id": "src",
      "type": "source",
      "x": 60,
      "y": 300,
      "props": {
        "interval": 2,
        "midiNote": 60,
        "noteIndex": -2,
        "intensity": 0.6
      }
    },
    {
      "id": "pol",
      "type": "oscillator",
      "x": 160,
      "y": 300,
      "props": {
        "wave": "triangle",
        "attack": 0.02,
        "decay": 0.3
      }
    },
    {
