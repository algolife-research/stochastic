# Supabase Configuration
# Copy this file to .env and fill in your Supabase credentials

# OpenRouter API Key (required for AI features)
# Get your key from https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# AI Planning Model (for creating composition plans - smart, expensive)
# Defaults to anthropic/claude-sonnet-4
# Recommended: anthropic/claude-sonnet-4, openai/gpt-4o, google/gemini-2.0-flash-thinking-exp
VITE_AI_PLANNING_MODEL=anthropic/claude-sonnet-4.5

# AI Execution Model (for executing phases - fast, cheap)
# Defaults to openai/gpt-4o-mini
# Recommended: openai/gpt-4o-mini, anthropic/claude-haiku-4, google/gemini-2.0-flash-exp
# For free: qwen/qwen3-coder:free, meta-llama/llama-3.3-70b-instruct:free
# NOTE: OpenRouter's free roster rotates — if a :free model starts returning
# 404 "free period has ended", pick a current one at https://openrouter.ai/models
VITE_AI_EXECUTION_MODEL=qwen/qwen3-coder:free

# Your Supabase project URL (found in Settings > API)
VITE_SUPABASE_URL=

# Your Supabase anon/public key (found in Settings > API)
VITE_SUPABASE_ANON_KEY=

# Example library base URL (optional)
# Where the app fetches examples and full compositions from at runtime.
# Defaults to the public stochastic-examples repository:
# https://raw.githubusercontent.com/algolife-research/stochastic-examples/main
# Point it at a fork or a locally served copy to override.
VITE_EXAMPLES_BASE_URL=
